{
  "name": "electron-analysis-app",
  "version": "1.0.0",
  "description": "Desktop app for correlation-network analysis of microbiome abundance data",
  "main": "src/main/index.js",
  "desktopName": "electron-analysis-app.desktop",
  "scripts": {
    "start": "electron .",
    "start:system-electron": "ELECTRON_OVERRIDE_DIST_PATH=/usr/lib/electron electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "cross-env NODE_ENV=development nodemon --exec electron . --watch src/main",
    "build:renderer": "vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "npm run build:renderer && npm run build:backend && electron-builder",
    "build:app": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && node scripts/build-backend.mjs --target win32 && cross-env WINEDLLOVERRIDES=mscoree,mshtml= electron-builder --win",
    "build:mac": "npm run build:renderer && node scripts/build-backend.mjs --target darwin && electron-builder --mac",
    "build:linux": "npm run build:renderer && node scripts/build-backend.mjs --target linux && electron-builder --linux",
    "icons": "node scripts/generate-icons.js",
    "test": "jest tests/unit --passWithNoTests",
    "test:unit": "jest tests/unit",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:e2e:full": "cross-env E2E_FULL=1 node --test tests/e2e/full-workflow.test.mjs",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write src"
  },
  "keywords": [
    "electron",
    "analysis",
    "python",
    "microbiome",
    "correlation-network",
    "sparcc"
  ],
  "author": "The authors of this project",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.3.3",
    "chart.js": "^4.4.0",
    "clsx": "^2.1.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "playwright": "^1.44.0",
    "prettier": "^3.0.0",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.3",
    "vite": "^8.0.0",
    "zustand": "^4.5.0"
  },
  "dependencies": {
    "electron-log": "^5.1.0",
    "electron-store": "^8.2.0",
    "shelljs": "^0.10.0"
  },
  "build": {
    "appId": "org.microbiome.networkanalysis",
    "productName": "Analysis App",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "resources/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist",
        "to": "python-dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "extraResources": [
        {
          "from": "resources/bin/win32",
          "to": "bin/win32"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.education",
      "extraResources": [
        {
          "from": "resources/bin/darwin",
          "to": "bin/darwin"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icons/icon.png",
      "category": "Science",
      "extraResources": [
        {
          "from": "resources/bin/linux",
          "to": "bin/linux"
        }
      ],
      "syncDesktopName": true
    }
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "@swc/core@1.16.2": true
  }
}
